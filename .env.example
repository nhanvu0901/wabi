# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# OpenRouter (Server-side only — LLM & Embedding models)
OPENROUTER_API_KEY=

# Resend Email Service (Server-side only)
# 1. API key from resend.com
RESEND_API_KEY=

# 2. Email receiving admin notifications when a user submits contact form
# (Note: If using onboarding@resend.dev, this MUST be the email registered with your Resend account)
ADMIN_NOTIFICATION_EMAIL=

# 3. Sender address (e.g. "Wabi Therapy <onboarding@resend.dev>" or "Wabi Therapy <lienhe@yourdomain.com>")
RESEND_FROM_EMAIL="Wabi Therapy <onboarding@resend.dev>"
